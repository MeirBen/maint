#!/usr/bin/env bash
set -Eeuo pipefail

# maint: the Maintenance command. One entry point for every module in modules/; see `maint help`.

SELF="$(readlink -f -- "${BASH_SOURCE[0]}")"
# shellcheck source=lib/common.sh
source "${SELF%/*}/lib/common.sh"

# Registry in menu order, filled by load_modules: one ENTRY_* row per action.
MODULE_IDS=()
declare -A MODULE_TITLES=()
ENTRY_MODULES=()
ENTRY_ACTIONS=()
ENTRY_DESCRIPTIONS=()

load_modules() {
    local file id rows title action description
    for file in "${MAINT_ROOT}"/modules/*.sh; do
        [[ -e "$file" ]] || continue
        id="${file##*/}"
        id="${id%.sh}"
        if ! rows="$(describe_module "$file")"; then
            printf 'Skipping module %s: it failed to load.\n' "${file##*/}" >&2
            continue
        fi
        { read -r title
          MODULE_IDS+=("$id")
          MODULE_TITLES[$id]="$title"
          while IFS='|' read -r action description; do
              ENTRY_MODULES+=("$id")
              ENTRY_ACTIONS+=("$action")
              ENTRY_DESCRIPTIONS+=("$description")
          done
        } <<< "$rows"
    done
}

# Prints the module's title, then one "action|description" row per action.
# The subshell keeps modules from seeing or overriding each other.
describe_module() (
    local row
    # shellcheck source=/dev/null
    source "$1" || exit 1
    [[ -n "${MODULE_TITLE:-}" ]] && (( ${#MODULE_ACTIONS[@]} )) || exit 1
    printf '%s\n' "$MODULE_TITLE"
    for row in "${MODULE_ACTIONS[@]}"; do
        declare -F "action_${row%%|*}" > /dev/null || exit 1
        printf '%s\n' "$row"
    done
)

# Prints the registry index of MODULE ACTION, or fails when it is not registered.
find_entry() {
    local index
    for index in "${!ENTRY_MODULES[@]}"; do
        if [[ "${ENTRY_MODULES[index]}" == "$1" && "${ENTRY_ACTIONS[index]}" == "$2" ]]; then
            printf '%s\n' "$index"
            return 0
        fi
    done
    return 1
}

# Reports an unknown module, or an unknown action of MODULE, with the valid choices.
reject() {
    local message="$1" module="${2:-}" index choices=""
    if [[ -z "$module" ]]; then
        printf -v choices '%s, ' "${MODULE_IDS[@]}"
    else
        for index in "${!ENTRY_MODULES[@]}"; do
            if [[ "${ENTRY_MODULES[index]}" == "$module" ]]; then
                choices+="${ENTRY_ACTIONS[index]}, "
            fi
        done
    fi
    choices="${choices%, }"
    printf "%s Choose from: %s. Run 'maint help' for details.\n" "$message" "${choices:-none}" >&2
    exit 2
}

usage() {
    local index
    cat <<'EOF'
Usage: maint [MODULE [ACTION]]

  maint                  Open the menu
  maint MODULE           Open one module's menu
  maint MODULE ACTION    Run one action
  maint list             Print every action as tab-separated MODULE, ACTION, TITLE, DESCRIPTION
  maint help             Show this help

Actions:
EOF
    for index in "${!ENTRY_MODULES[@]}"; do
        printf '  %-22s %s\n' "maint ${ENTRY_MODULES[index]} ${ENTRY_ACTIONS[index]}" \
            "${ENTRY_DESCRIPTIONS[index]}"
    done
}

# Machine-readable registry for completion and other front ends; keep the columns stable.
list_actions() {
    local index
    for index in "${!ENTRY_MODULES[@]}"; do
        printf '%s\t%s\t%s\t%s\n' "${ENTRY_MODULES[index]}" "${ENTRY_ACTIONS[index]}" \
            "${MODULE_TITLES[${ENTRY_MODULES[index]}]}" "${ENTRY_DESCRIPTIONS[index]}"
    done
}

run_action() {
    local module="$1" action="$2"
    # shellcheck source=/dev/null
    source "${MAINT_ROOT}/modules/${module}.sh"
    initialize_runtime "$module" "${MODULE_TITLES[$module]} ${action}"
    "action_${action}"
}

# Each choice runs in a child process, so its lock, traps, and temporary files
# are released before the menu returns.
run_menu() {
    local module_filter="${1:-}" index position choice status module
    local -a choices=()
    # Bash defers these until a running action exits, so it always cleans up first.
    trap 'exit 129' HUP
    trap 'exit 143' TERM
    for index in "${!ENTRY_MODULES[@]}"; do
        if [[ -z "$module_filter" || "${ENTRY_MODULES[index]}" == "$module_filter" ]]; then
            choices+=("$index")
        fi
    done

    while true; do
        echo
        echo 'Maintenance'
        module=""
        for position in "${!choices[@]}"; do
            index="${choices[position]}"
            if [[ "${ENTRY_MODULES[index]}" != "$module" ]]; then
                module="${ENTRY_MODULES[index]}"
                printf '\n%s\n' "${MODULE_TITLES[$module]}"
            fi
            printf '  %2d) %s\n' "$((position + 1))" "${ENTRY_DESCRIPTIONS[index]}"
        done
        printf '\n   0) Exit\n\n'

        while true; do
            read -r -p "Choose [0-${#choices[@]}]: " choice || return 0
            if [[ "$choice" == 0 ]]; then
                return 0
            fi
            if [[ "$choice" =~ ^[1-9][0-9]*$ ]] && (( choice <= ${#choices[@]} )); then
                break
            fi
            echo "Please choose a number from 0 to ${#choices[@]}."
        done

        index="${choices[choice - 1]}"
        status=0
        "$BASH" "$SELF" "${ENTRY_MODULES[index]}" "${ENTRY_ACTIONS[index]}" || status=$?
        case "$status" in
            129|130|143) return "$status" ;;
        esac
        if [[ -t 0 ]]; then
            echo
            read -r -p 'Press Enter to return to the menu...' || return 0
        fi
    done
}

main() {
    local index
    load_modules
    case "$#:${1:-}" in
        0:) run_menu ;;
        1:help|1:-h|1:--help) usage ;;
        1:list) list_actions ;;
        1:*)
            [[ -n "${MODULE_TITLES[$1]+set}" ]] || reject "Unknown module '$1'."
            run_menu "$1" ;;
        2:*)
            [[ -n "${MODULE_TITLES[$1]+set}" ]] || reject "Unknown module '$1'."
            index="$(find_entry "$1" "$2")" || reject "Unknown action '$2' for $1." "$1"
            run_action "${ENTRY_MODULES[index]}" "${ENTRY_ACTIONS[index]}" ;;
        *)
            usage >&2
            return 2 ;;
    esac
}

main "$@"
