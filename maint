#!/usr/bin/env bash
set -Eeuo pipefail

# maint: entry point of the modular maintenance framework. Discovers the modules in modules/,
# then opens the menu or runs one action; see `maint help`.

readonly MAINT_VERSION='0.1.0'
MAINT_ROOT="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
# Actions run in this separate process; the menu and command line never load lib/common.sh.
RUNNER="${MAINT_ROOT}/lib/run.sh"
# shellcheck source=lib/terminal.sh
source "${MAINT_ROOT}/lib/terminal.sh"

# Registry in menu order, filled by load_modules: one ENTRY_* row per action.
MODULE_IDS=()
declare -A MODULE_TITLES=()
ENTRY_MODULES=()
ENTRY_ACTIONS=()
ENTRY_DESCRIPTIONS=()

load_modules() {
    local file id rows title action description
    for file in "${MAINT_ROOT}"/modules/*.sh; do
        [[ -e "$file" ]] || continue
        id="${file##*/}"
        id="${id%.sh}"
        case "$id" in
            help|list|-h|--help|-V|--version|--no-color|--)
                printf 'Skipping module %s: %s is a built-in command.\n' "${file##*/}" "$id" >&2
                continue ;;
        esac
        if ! rows="$(describe_module "$file")"; then
            printf 'Skipping module %s: it failed to load.\n' "${file##*/}" >&2
            continue
        fi
        { read -r title
          MODULE_IDS+=("$id")
          MODULE_TITLES[$id]="$title"
          while IFS='|' read -r action description; do
              ENTRY_MODULES+=("$id")
              ENTRY_ACTIONS+=("$action")
              ENTRY_DESCRIPTIONS+=("$description")
          done
        } <<< "$rows"
    done
}

# Prints the module's title, then one "action|description" row per action.
# The subshell keeps modules from seeing or overriding each other; discarding what a module
# prints while loading keeps the rows intact.
describe_module() (
    local row
    # shellcheck source=/dev/null
    source "$1" > /dev/null || exit 1
    [[ -n "${MODULE_TITLE:-}" && -n "${MODULE_ACTIONS[*]:-}" ]] || exit 1
    printf '%s\n' "$MODULE_TITLE"
    for row in "${MODULE_ACTIONS[@]}"; do
        declare -F "action_${row%%|*}" > /dev/null || exit 1
        printf '%s\n' "$row"
    done
)

is_registered() {
    local index
    for index in "${!ENTRY_MODULES[@]}"; do
        if [[ "${ENTRY_MODULES[index]}" == "$1" && "${ENTRY_ACTIONS[index]}" == "$2" ]]; then
            return 0
        fi
    done
    return 1
}

# Reports an unknown module, or an unknown action of MODULE, with the valid choices.
reject() {
    local message="$1" module="${2:-}" index choices=""
    if [[ -z "$module" ]]; then
        printf -v choices '%s, ' "${MODULE_IDS[@]}"
    else
        for index in "${!ENTRY_MODULES[@]}"; do
            if [[ "${ENTRY_MODULES[index]}" == "$module" ]]; then
                choices+="${ENTRY_ACTIONS[index]}, "
            fi
        done
    fi
    choices="${choices%, }"
    usage_error "$message Choose from: ${choices:-none}."
}

usage_error() {
    printf "maint: %s\nTry 'maint --help' for usage.\n" "$1" >&2
    exit 2
}

usage() {
    local module="${1:-}" action="${2:-}" index
    terminal_setup
    printf 'maint %s - System and container maintenance\n\n' "$MAINT_VERSION"
    if [[ -z "$module" ]]; then
        cat <<'EOF'
Usage: maint [OPTIONS] [MODULE [ACTION]]
       maint help [MODULE [ACTION]]
       maint list

Run without arguments to open the menu, or with MODULE to open its menu.
Provide MODULE ACTION to run one action and exit.

Commands:
EOF
        printf '  %-22s %s\n' \
            'help [MODULE [ACTION]]' 'Show general or command-specific help' \
            'list' 'List actions as tab-separated values'
    elif [[ "$module" == list ]]; then
        printf 'Usage: maint [OPTIONS] list\n\n'
        printf 'Print tab-separated MODULE, ACTION, TITLE, DESCRIPTION for each action.\n'
    elif [[ -z "$action" ]]; then
        printf 'Usage: maint [OPTIONS] %s [ACTION]\n\n' "$module"
        printf 'Open the %s menu, or run one of its actions directly.\n' "${MODULE_TITLES[$module]}"
    else
        printf 'Usage: maint [OPTIONS] %s %s\n' "$module" "$action"
    fi

    if [[ "$module" != list ]]; then
        printf '\nActions:\n'
        for index in "${!ENTRY_MODULES[@]}"; do
            [[ -z "$module" || "${ENTRY_MODULES[index]}" == "$module" ]] || continue
            [[ -z "$action" || "${ENTRY_ACTIONS[index]}" == "$action" ]] || continue
            terminal_wrap '  ' "maint ${ENTRY_MODULES[index]} ${ENTRY_ACTIONS[index]}" "$TERMINAL_WIDTH"
            terminal_wrap '    ' "${ENTRY_DESCRIPTIONS[index]}" "$TERMINAL_WIDTH"
        done
    fi
    printf '\nOptions:\n'
    printf '  %-22s %s\n' \
        '-h, --help' 'Show help for the selected command and exit' \
        '-V, --version' 'Show the program version and exit (used alone)' \
        '    --no-color' "Disable maint's terminal colors" \
        '    --' 'Stop parsing options'
    cat <<'EOF'

Options may appear before or after MODULE and ACTION, up to --.

Exit status:
  0  Success or cancellation
  2  Invalid command or arguments
  Other failures preserve the action's exit status; Ctrl+C returns 130.
EOF
    if [[ -z "$module" ]]; then
        cat <<'EOF'

Examples:
  maint docker --help
  maint docker list
  maint --no-color sys update
EOF
    fi
}

# Machine-readable registry for completion and other front ends; keep the columns stable.
list_actions() {
    local index
    for index in "${!ENTRY_MODULES[@]}"; do
        printf '%s\t%s\t%s\t%s\n' "${ENTRY_MODULES[index]}" "${ENTRY_ACTIONS[index]}" \
            "${MODULE_TITLES[${ENTRY_MODULES[index]}]}" "${ENTRY_DESCRIPTIONS[index]}"
    done
}

# Each choice runs in its own runner process, so its lock, traps, and temporary files
# are released before the menu returns.
run_menu() {
    local module_filter="${1:-}" index position choice status module width prefix number_width
    local -a choices=()
    # Bash defers these until a running action exits, so it always cleans up first.
    trap 'exit 129' HUP
    trap 'exit 143' TERM
    for index in "${!ENTRY_MODULES[@]}"; do
        if [[ -z "$module_filter" || "${ENTRY_MODULES[index]}" == "$module_filter" ]]; then
            choices+=("$index")
        fi
    done
    number_width="${#choices[@]}"
    number_width="${#number_width}"

    while true; do
        terminal_setup
        width="$TERMINAL_WIDTH"
        (( width <= 88 )) || width=88
        printf '\n  %sMaintenance%s\n' "$TERMINAL_BOLD" "$TERMINAL_RESET"
        terminal_rule "$((width - 4))"
        module=""
        for position in "${!choices[@]}"; do
            index="${choices[position]}"
            if [[ "${ENTRY_MODULES[index]}" != "$module" ]]; then
                module="${ENTRY_MODULES[index]}"
                printf '\n  %s%s%s\n' "$TERMINAL_ACCENT" "${MODULE_TITLES[$module]}" "$TERMINAL_RESET"
            fi
            printf -v prefix '    %*d) ' "$number_width" "$((position + 1))"
            terminal_wrap "$prefix" "${ENTRY_DESCRIPTIONS[index]}" "$((width - 2))"
        done
        printf '\n'
        terminal_rule "$((width - 4))"
        printf '    %*d) Exit\n\n' "$number_width" 0

        while true; do
            read -r -p "  Choose [0-${#choices[@]}]: " choice || return 0
            if [[ "$choice" == 0 ]]; then
                return 0
            fi
            if [[ "$choice" =~ ^[1-9][0-9]*$ ]] && (( choice <= ${#choices[@]} )); then
                break
            fi
            printf '  Please choose a number from 0 to %s.\n' "${#choices[@]}"
        done

        index="${choices[choice - 1]}"
        status=0
        printf '\n'
        "$BASH" "$RUNNER" "${ENTRY_MODULES[index]}" "${ENTRY_ACTIONS[index]}" || status=$?
        case "$status" in
            129|130|143) return "$status" ;;
        esac
        if [[ -t 0 ]]; then
            echo
            read -r -p '  Press Enter to return to the menu...' || return 0
        fi
    done
}

main() {
    local show_help=0 show_version=0 argument
    local -a arguments=()
    while (( $# > 0 )); do
        case "$1" in
            -h|--help) show_help=1 ;;
            -V|--version) show_version=1 ;;
            --no-color) export NO_COLOR=1 ;;
            --) shift; arguments+=("$@"); break ;;
            -*) usage_error "Unknown option '$1'." ;;
            *) arguments+=("$1") ;;
        esac
        shift
    done
    set -- "${arguments[@]}"
    if (( show_version )); then
        (( show_help == 0 && $# == 0 )) || usage_error '--version must be used without a command or --help.'
        printf 'maint %s\n' "$MAINT_VERSION"
        return 0
    fi
    if [[ "${1:-}" == help ]]; then
        show_help=1
        shift
    fi
    (( $# <= 2 )) || usage_error "Unexpected argument '$3'."
    for argument in "$@"; do
        [[ -n "$argument" ]] || usage_error 'Module and action names must not be empty.'
    done

    load_modules
    case "$#:${1:-}" in
        0:)
            if (( show_help )); then usage; else run_menu; fi ;;
        1:list)
            if (( show_help )); then usage list; else list_actions; fi ;;
        2:list) usage_error "The 'list' command does not accept arguments." ;;
        *)
            [[ -n "${MODULE_TITLES[$1]+set}" ]] || reject "Unknown module '$1'."
            if (( $# == 2 )); then
                is_registered "$1" "$2" || reject "Unknown action '$2' for $1." "$1"
            fi
            if (( show_help )); then
                usage "$@"
            elif (( $# == 1 )); then
                run_menu "$1"
            else
                exec "$BASH" "$RUNNER" "$1" "$2"
            fi ;;
    esac
}

main "$@"
